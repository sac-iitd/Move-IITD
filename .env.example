# =====================================================================
# MoveIITD — SAC Bus Booking (IIT Delhi <-> Sonipat) — configuration
#
# Copy to `.env` ON THE SERVER and fill every <...> placeholder.
#   cp .env.example .env && chmod 600 .env
# Never commit `.env`. Never put secrets in a VITE_ variable (those are public).
# Values below are set for production at https://sac.iitd.ac.in/MoveIITD/.
# For local development see the "LOCAL DEVELOPMENT" block at the end.
# =====================================================================

# --- Runtime -----------------------------------------------------------
NODE_ENV=production
# Port the Node API listens on (Apache proxies /MoveIITD/ to it).
PORT=4000
# Public origin (scheme + host only, no path).
WEB_ORIGIN=https://sac.iitd.ac.in
# Sub-path the app lives under (leading slash, no trailing slash).
APP_BASE_PATH=/MoveIITD
# Reverse-proxy hops in front of Node (Apache = 1).
TRUST_PROXY=1
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info

# --- Database (MySQL 8) -----------------------------------------------
# Create the DB/user first (see README §4). URL-encode special characters in the password.
DATABASE_URL="mysql://bus_app:<MYSQL_PASSWORD>@127.0.0.1:3306/iitd_bus"

# --- Sessions ----------------------------------------------------------
# >= 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>
SESSION_TTL_HOURS=12

# --- Authentication: IIT Delhi OAuth 2 ("KEBROS") ---------------------
# Client "Nexus – SAC BusBooking Portal", registered by sysadm@cc.iitd.ac.in (13 Oct 2026).
AUTH_PROVIDER=kebros
AUTH_DEV_MOCK_ENABLED=false
KEBROS_AUTHORIZE_URL=https://oauth2.iitd.ac.in/authorize.php
KEBROS_TOKEN_URL=https://oauth2.iitd.ac.in/token.php
KEBROS_RESOURCE_URL=https://oauth2.iitd.ac.in/resource.php
# Client ID is public (it appears in the login link).
KEBROS_CLIENT_ID=FUPav5pAyxYdvZTi8elrAAzJHn6dRvn1
# SECRET — paste from the sysadm email, only into the server .env.
KEBROS_CLIENT_SECRET=<KEBROS_CLIENT_SECRET>
# Must match the registered Redirect URI exactly.
KEBROS_REDIRECT_URI=https://sac.iitd.ac.in/MoveIITD/api/auth/iitd/callback
KEBROS_TIMEOUT_MS=10000
# Optional eligibility filters (comma-separated, lower-case). Empty = anyone with a Kerberos login.
#   KEBROS_ALLOWED_EMAIL_DOMAINS=iitd.ac.in,admin.iitd.ac.in
#   KEBROS_ALLOWED_CATEGORIES=student,faculty,staff
KEBROS_ALLOWED_EMAIL_DOMAINS=
KEBROS_ALLOWED_CATEGORIES=

# --- Admins ------------------------------------------------------------
# Promoted to ADMIN when they sign in. Entries with "@" match the email IITD returns;
# others match the Kerberos user_id. Listing both forms is safe.
# Confirmed 13 Oct 2026: DGS SAC, security officer, Dean Sonipat, EOA security.
ADMIN_ALLOWLIST=dgssac,sec_officer,deansonipat,eoasecurity,cs5240081,dgssac@iitd.ac.in,sec_officer@iitd.ac.in,deansonipat@iitd.ac.in,eoasecurity@iitd.ac.in,cs5240081@iitd.ac.in,cs5240081@cse.iitd.ac.in

# --- Email (IITD SMTP) -------------------------------------------------
# From csc.iitd.ac.in: smtp.iitd.ac.in, authentication required,
# SSL/TLS on 465 (used here) or STARTTLS on 25 (then SMTP_PORT=25, SMTP_SECURE=false).
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.iitd.ac.in
SMTP_PORT=465
SMTP_SECURE=true
# Login id of the mailbox that sends the mails (any IITD mailbox, e.g. a no-reply or dgssac).
SMTP_USER=<SMTP_LOGIN_ID>
# SECRET — that mailbox's password. Only in the server .env.
# Quote the value if it contains #. An unquoted # is treated as a comment, so the rest of the password is dropped and SMTP login fails.
SMTP_PASSWORD="<SMTP_PASSWORD>"
# Only if TLS fails with a certificate error: path to the Entrust CA PEM from CSC.
# SMTP_CA_FILE=/opt/moveiitd/entrust-ca.pem
# Sender shown to passengers. Usually the address of the SMTP_USER mailbox
# (IITD SMTP may reject a From address the login does not own).
EMAIL_FROM_NAME=MoveIITD – SAC Bus Service
EMAIL_FROM_ADDRESS=<SENDER_EMAIL_ADDRESS>
# Optional: where passenger replies go (e.g. the SAC office mailbox). Leave empty to use the sender.
EMAIL_REPLY_TO=

# --- Privacy -----------------------------------------------------------
# Key used to encrypt guest ID-proof numbers (Aadhaar/PAN) in the database. >= 32 random chars.
# KEEP A SAFE COPY: if lost, stored ID numbers cannot be decrypted.
ID_ENCRYPTION_KEY=<GENERATE_ANOTHER_LONG_RANDOM_SECRET>
# Phone and ID-proof numbers are erased this many days after the trip (6 months).
PII_RETENTION_DAYS=180

# --- Background jobs ---------------------------------------------------
ENABLE_BACKGROUND_JOBS=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=8
# Days ahead to generate trips (must cover the 7-day booking window).
TRIP_GENERATION_HORIZON_DAYS=14
TRIP_GENERATION_INTERVAL_MINUTES=60

# --- Serve the built web app from Node (recommended) -------------------
# Path to apps/web/dist, relative to apps/api. Build it with:
#   VITE_BASE_PATH=/MoveIITD/ VITE_API_BASE=/MoveIITD/api/v1 npm run build
SERVE_WEB_DIR=../web/dist

# =====================================================================
# LOCAL DEVELOPMENT (your laptop) — replace the values above with:
#   NODE_ENV=development
#   WEB_ORIGIN=http://localhost:5173
#   APP_BASE_PATH=
#   TRUST_PROXY=0
#   DATABASE_URL="file:./dev.db?connection_limit=1"
#   AUTH_PROVIDER=dev-mock
#   AUTH_DEV_MOCK_ENABLED=true          # real IITD login only works on sac.iitd.ac.in
#   ADMIN_ALLOWLIST=devadmin
#   EMAIL_TRANSPORT=file                # writes .eml files to .mail/ instead of sending
#   EMAIL_FILE_DIR=.mail
#   SERVE_WEB_DIR=                       # Vite dev server serves the UI
# =====================================================================
